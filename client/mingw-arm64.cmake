set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
find_program(CMAKE_C_COMPILER NAMES aarch64-w64-mingw32-clang
  HINTS "$ENV{LLVM_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES aarch64-w64-mingw32-clang++
  HINTS "$ENV{LLVM_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES aarch64-w64-mingw32-windres
  HINTS "$ENV{LLVM_MINGW_ROOT}/bin" REQUIRED)
