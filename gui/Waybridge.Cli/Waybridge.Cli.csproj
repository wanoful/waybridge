<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>waybridge</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationIcon>../../assets/branding/waybridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Waybridge.Control.Core.Localization" Static="true" />
    <ProjectReference Include="../Waybridge.Control.Core/Waybridge.Control.Core.csproj" />
  </ItemGroup>
</Project>
