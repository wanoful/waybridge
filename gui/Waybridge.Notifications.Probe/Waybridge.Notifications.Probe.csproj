<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkVersion>1.8.260921001</WindowsAppSdkVersion>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled><EnablePriGenTooling>false</EnablePriGenTooling>
    <ApplicationManifest>../Waybridge.Control/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Compile Include="../Waybridge.Control/DesktopNotifications.cs" Link="DesktopNotifications.cs" />
  </ItemGroup>
  <UsingTask TaskName="WaybridgeExtractProbeRuntimeResources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FrameworkPackage ParameterType="System.String" Required="true" />
      <PublishDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" /><Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)../../scripts/extract-runtime-resources.cs" />
    </Task>
  </UsingTask>
  <Target Name="PublishProbeRuntimeResources" AfterTargets="Publish">
    <PropertyGroup>
      <_ProbeFrameworkRid>$([System.String]::Copy('$(RuntimeIdentifier)').Replace('win-', 'win10-'))</_ProbeFrameworkRid>
      <_ProbeFrameworkPackage>$(NuGetPackageRoot)microsoft.windowsappsdk.runtime/$(WindowsAppSdkVersion)/tools/MSIX/$(_ProbeFrameworkRid)/Microsoft.WindowsAppRuntime.1.8.msix</_ProbeFrameworkPackage>
    </PropertyGroup>
    <WaybridgeExtractProbeRuntimeResources FrameworkPackage="$(_ProbeFrameworkPackage)" PublishDirectory="$(PublishDir)" />
  </Target>
</Project>
